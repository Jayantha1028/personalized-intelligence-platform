# ============================================================
# Personalized Intelligence Platform — Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# ----- Database -----
# Default: SQLite for local zero-setup development
DATABASE_URL=sqlite+aiosqlite:///./platform.db

# PostgreSQL (recommended for production):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/platform

# ----- AI Summarization (Optional) -----
# If set, Gemini Flash is used for richer summaries; otherwise local CPU extractive is used.
# Free tier (60 req/min) is sufficient for personal use.
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ----- Telegram Notifications (Optional) -----
# Create a bot via @BotFather and get its token.
# Get your chat_id by messaging @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ----- App Settings -----
APP_ENV=development
# Change this to a random string in production:
SECRET_KEY=change-me-in-production

# ----- Email Notifications (Optional) -----
EMAIL_NOTIFICATIONS_ENABLED=false
